# 로컬 실행용 예시. `cp .env.example .env` 후 값을 채우면 main.py가 자동으로 읽는다.
# 이미 설정된 환경 변수가 우선하므로, export 해 둔 값이 있으면 그쪽이 이긴다.
# `.env`는 .gitignore에 있다. GitHub Actions에서는 리포지토리 Secrets로 등록한다.

# LLM: 앞에서부터 시도하고 실패하면 다음으로 폴백한다.
# 최소 하나는 있어야 하며, 없는 것은 건너뛴다.
GEMINI_API_KEY=
GROQ_API_KEY=
# OPENAI_API_KEY=sk-...

# 알림: config.yaml의 notifier.channels에 켜 둔 채널 것만 채우면 된다.
# Discord: 채널 설정 → 연동 → 웹훅 → 새 웹훅 → URL 복사
DISCORD_WEBHOOK_URL=

# Email: Gmail이면 앱 비밀번호(계정 비밀번호 아님)
SMTP_USER=
SMTP_PASSWORD=

# Telegram (기본 비활성)
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_CHAT_ID=-1001234567890

# 선택: 설정하면 Reddit을 익명 대신 application-only OAuth로 호출한다.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
